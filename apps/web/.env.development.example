# ── RoofersLabs web — DEVELOPMENT ───────────────────────────────────────────
# Copy to apps/web/.env.development. Vite loads it automatically for
# `npm run dev` (mode=development). Only VITE_* vars reach the browser — never
# put a secret in any of these files.

# Clerk DEVELOPMENT instance (pk_test_…). A pk_live_ key here would sign local
# work in to production identities.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx

# API origin. EMPTY for local work: the Vite dev server proxies /v1 to
# http://localhost:4000.
#
# To run the local frontend against the DEPLOYED development API instead, set:
#   VITE_API_BASE_URL=https://api.dev.rooferslabs.com
# That origin is already in the development API's CORS list.
VITE_API_BASE_URL=
