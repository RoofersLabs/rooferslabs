# ── RoofersLabs web (apps/web) ──────────────────────────────────────────────
# Copy to apps/web/.env and fill in. Only VITE_* vars are exposed to the browser.

# Clerk publishable key (browser-safe). Required in every environment.
# Clerk Dashboard → API Keys. Use pk_test_… locally, pk_live_… in production.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx

# API origin. Leave EMPTY in development — the Vite dev server proxies /v1 to the
# local API (http://localhost:4000). REQUIRED in production builds (Vercel
# rewrites every path to index.html, so there is no same-origin API): set it to
# the absolute API origin, without a trailing /v1.
#   production: VITE_API_BASE_URL=https://api.rooferslabs.com
VITE_API_BASE_URL=
