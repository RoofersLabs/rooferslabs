# =============================================================================
# RoofersLabs Web (PWA) — environment configuration
# =============================================================================
# Copy to apps/web/.env for local development. Vite exposes only VITE_-prefixed
# variables to the browser — never put secrets here.

# Clerk publishable key (safe for the browser).
#   Where: https://dashboard.clerk.com → your app → API Keys → Publishable key
#   Why:   renders the hosted sign-in/sign-up UI and issues session tokens.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Backend API base URL.
#   Leave empty for local dev (the Vite dev server proxies /v1 → localhost:4000).
#   In production set to the API origin, e.g. https://api.rooferslabs.com
VITE_API_BASE_URL=
