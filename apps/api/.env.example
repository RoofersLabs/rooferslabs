# ── RoofersLabs API (apps/api) ──────────────────────────────────────────────
# Copy to apps/api/.env and fill in. Never commit real secrets.
# Startup validation (src/config/env.validation.ts) fails fast if a required
# variable is missing; feature credentials only disable their capability.

# ── Runtime ─────────────────────────────────────────────────────────────────
NODE_ENV=development
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000
WEB_PUBLIC_URL=http://localhost:5173
# Comma-separated allowed CORS origins.
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=info

# ── Data stores (DATABASE_URL required in every environment) ────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rooferslabs
REDIS_URL=redis://localhost:6379

# ── Clerk (secret + publishable required in production) ──────────────────────
CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx
# Optional: networkless JWT verification + webhook signature verification.
CLERK_JWT_KEY=
CLERK_WEBHOOK_SECRET=

# ── OpenAI (feature: AI receptionist + post-call analysis) ───────────────────
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_REALTIME_URL=wss://api.openai.com/v1/realtime
OPENAI_RESPONSES_MODEL=gpt-4.1
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ── Twilio (feature: inbound telephony) ──────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxx
# Public wss:// URL Twilio streams call audio to (ngrok/API host in prod).
TWILIO_MEDIA_STREAM_URL=ws://localhost:4000/v1/telephony/media-stream

# ── AWS (S3 recordings/uploads, optional SQS) ────────────────────────────────
AWS_REGION=us-east-1
# Omit on ECS (uses the task role); set for local dev against real AWS.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_RECORDINGS=rooferslabs-recordings-dev
S3_BUCKET_UPLOADS=rooferslabs-uploads-dev
# Empty → run background jobs inline (see BACKGROUND_JOBS_INLINE); set to use SQS.
SQS_QUEUE_URL=
BACKGROUND_JOBS_INLINE=true

# ── Web Push (VAPID) ─────────────────────────────────────────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@rooferslabs.com
