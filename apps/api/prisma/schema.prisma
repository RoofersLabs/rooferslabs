generator client {
  provider        = "prisma-client-js"
  previewFeatures = []
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id                      String             @id @default(cuid())
  name                    String
  slug                    String             @unique
  /// Whether this tenant may use the platform, and the only thing that decides
  /// it. `AccountStatusGuard` reads this column on every tenant-scoped request;
  /// the columns below record *who* moved it and *when*, and are never consulted
  /// by an authorization decision.
  status                  CompanyStatus      @default(ONBOARDING)
  onboardingStep          OnboardingStep     @default(COMPANY)
  onboardedAt             DateTime?
  /// When the founder approved this account. Null while PENDING_APPROVAL, and
  /// deliberately *not* cleared by a later pause — an account that has been
  /// approved once keeps the date it happened.
  approvedAt              DateTime?
  /// The `users.id` of the staff account that approved it. A plain id rather
  /// than a relation, so removing a staff account never rewrites the record of
  /// a decision they made.
  approvedBy              String?
  pausedAt                DateTime?
  pausedBy                String?
  /// Optional note from the founder. Internal — never shown to the tenant, who
  /// is told to contact support rather than given an operational reason.
  pauseReason             String?
  email                   String?
  phone                   String?
  website                 String?
  addressLine1            String?
  addressLine2            String?
  city                    String?
  state                   String?
  postalCode              String?
  timezone                String             @default("America/New_York")
  serviceAreas            String[]           @default([])
  roofingServices         String[]           @default([])
  businessHours           Json?
  emergencyServiceEnabled Boolean            @default(true)
  emergencyPhone          String?
  emergencyInstructions   String?
  logoUrl                 String?
  primaryColor            String?            @default("#1E40AF")
  secondaryColor          String?
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt
  phoneCarrier            String?
  receptionistEnabled     Boolean            @default(true)
  aiConfiguration         AiConfiguration?
  appointments            Appointment[]
  auditLogs               AuditLog[]
  calls                   Call[]
  conversations           Conversation[]
  customers               Customer[]
  knowledgeArticle        KnowledgeArticle[]
  notifications           Notification[]
  phoneNumbers            PhoneNumber[]
  pushSubscriptions       PushSubscription[]
  subscription            Subscription?
  invoices                Invoice[]
  users                   User[]
  notes                   CompanyNote[]

  @@index([status])
  @@map("companies")
}

model AiConfiguration {
  id                  String   @id @default(cuid())
  companyId           String   @unique
  voice               String   @default("alloy")
  assistantName       String   @default("the RoofersLabs assistant")
  greeting            String   @default("Thanks for calling. How can I help you with your roofing needs today?")
  persona             String   @default("professional, warm, and efficient")
  customInstructions  String?
  captureLeads        Boolean  @default(true)
  detectEmergencies   Boolean  @default(true)
  requestAppointments Boolean  @default(true)
  transferToHuman     Boolean  @default(false)
  transferPhone       String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  company             Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("ai_configurations")
}

model User {
  id                 String             @id @default(cuid())
  companyId          String?
  clerkUserId        String             @unique
  email              String
  firstName          String?
  lastName           String?
  avatarUrl          String?
  role               UserRole           @default(OWNER)
  /// Legacy. The admin portal is gated on the staff email allow-list in
  /// `packages/shared/src/platform-admin.ts`, checked against the signed-in
  /// Clerk account — so whatever this column says grants nothing. Kept because
  /// dropping it would rewrite the table for no behavioural gain; the API
  /// derives the principal's `platformRole` from the email instead of reading
  /// it from here.
  platformRole       PlatformRole       @default(NONE)
  emailNotifications Boolean            @default(true)
  lastActiveAt       DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  deletedAt          DateTime?
  auditLogs          AuditLog[]
  notifications      Notification[]
  pushSubscriptions  PushSubscription[]
  company            Company?           @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@index([email])
  @@map("users")
}

model PhoneNumber {
  id                   String            @id @default(cuid())
  companyId            String
  phoneNumber          String            @unique
  twilioSid            String?           @unique
  friendlyName         String?
  status               PhoneNumberStatus @default(ASSIGNED)
  forwardingVerifiedAt DateTime?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  calls                Call[]
  company              Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("phone_numbers")
}

model Customer {
  id              String         @id @default(cuid())
  companyId       String
  fullName        String?
  phone           String?
  email           String?
  propertyAddress String?
  propertyType    PropertyType   @default(UNKNOWN)
  status          CustomerStatus @default(NEW)
  /// Starred by the company so their most important accounts stay reachable
  /// from any device. Company-wide, not per-user: a small roofing office
  /// shares one view of who matters.
  isFavorite      Boolean        @default(false)
  notes           String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  deletedAt       DateTime?
  appointments    Appointment[]
  calls           Call[]
  conversations   Conversation[]
  company         Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([companyId, phone])
  @@index([companyId, status])
  @@map("customers")
}

model Call {
  id                String        @id @default(cuid())
  companyId         String
  phoneNumberId     String?
  customerId        String?
  twilioCallSid     String?       @unique
  direction         CallDirection @default(INBOUND)
  fromNumber        String?
  toNumber          String?
  status            CallStatus    @default(INCOMING)
  startedAt         DateTime?
  answeredAt        DateTime?
  endedAt           DateTime?
  durationSeconds   Int?
  recordingUrl      String?
  recordingKey      String?
  // Twilio call recording (started automatically for every answered call).
  recordingSid      String?       @unique
  recordingStatus   String?
  recordingDuration Int?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  forwardedFrom     String?
  company           Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer          Customer?     @relation(fields: [customerId], references: [id])
  phoneNumber       PhoneNumber?  @relation(fields: [phoneNumberId], references: [id])
  conversation      Conversation?

  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, createdAt])
  @@map("calls")
}

model Conversation {
  id               String               @id @default(cuid())
  companyId        String
  callId           String               @unique
  customerId       String?
  status           ConversationStatus   @default(ACTIVE)
  outcome          ConversationOutcome?
  intent           ConversationIntent?
  leadQuality      LeadQuality?
  urgency          UrgencyLevel?
  isEmergency      Boolean              @default(false)
  transcript       Json?
  summary          String?
  keyPoints        String[]             @default([])
  structuredOutput Json?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  appointment      Appointment?
  call             Call                 @relation(fields: [callId], references: [id], onDelete: Cascade)
  company          Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer         Customer?            @relation(fields: [customerId], references: [id])

  @@index([companyId])
  @@index([companyId, outcome])
  @@index([companyId, isEmergency])
  @@index([companyId, createdAt])
  @@map("conversations")
}

model Appointment {
  id                  String              @id @default(cuid())
  companyId           String
  customerId          String?
  conversationId      String?             @unique
  serviceRequested    String?
  propertyAddress     String?
  preferredDate       DateTime?
  preferredTimeWindow String?
  status              AppointmentStatus   @default(REQUESTED)
  priority            AppointmentPriority @default(NORMAL)
  notes               String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  deletedAt           DateTime?
  company             Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  conversation        Conversation?       @relation(fields: [conversationId], references: [id])
  customer            Customer?           @relation(fields: [customerId], references: [id])

  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, createdAt])
  @@map("appointments")
}

model KnowledgeArticle {
  id        String            @id @default(cuid())
  companyId String
  title     String
  content   String
  category  KnowledgeCategory @default(FAQ)
  keywords  String[]          @default([])
  status    KnowledgeStatus   @default(PUBLISHED)
  version   Int               @default(1)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  deletedAt DateTime?
  company   Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  chunks    KnowledgeChunk[]

  @@index([companyId])
  @@index([companyId, category])
  @@index([companyId, status])
  @@map("knowledge_articles")
}

model KnowledgeChunk {
  id        String           @id @default(cuid())
  companyId String
  articleId String
  content   String
  embedding Float[]          @default([])
  tokens    Int              @default(0)
  createdAt DateTime         @default(now())
  article   KnowledgeArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([articleId])
  @@map("knowledge_chunks")
}

model Notification {
  id            String               @id @default(cuid())
  companyId     String
  userId        String?
  type          NotificationType
  priority      NotificationPriority @default(NORMAL)
  channel       NotificationChannel  @default(IN_APP)
  status        NotificationStatus   @default(UNREAD)
  title         String
  message       String
  relatedEntity Json?
  readAt        DateTime?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  deletedAt     DateTime?
  company       Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user          User?                @relation(fields: [userId], references: [id])

  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, userId, status])
  @@index([companyId, createdAt])
  @@map("notifications")
}

model PushSubscription {
  id        String   @id @default(cuid())
  companyId String
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([userId])
  @@map("push_subscriptions")
}

/// A private operational note about a company, written by rooferslabs staff.
/// Never exposed through any customer-facing endpoint — the admin controller is
/// the only route that reads or writes it.
model CompanyNote {
  id        String   @id @default(cuid())
  companyId String
  /// The staff user who wrote it. Kept as a plain id, not a relation, so
  /// deleting a staff account never cascades into the operational record.
  authorId  String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, createdAt])
  @@map("company_notes")
}

/// Billing state for a tenant, mirrored from the active payment provider by the
/// webhook handler. The provider is the source of truth; this table is a local
/// read-model so request-time authorization never depends on an outbound call.
///
/// Every provider-issued identifier is stored generically and qualified by
/// `provider`, so a row always says which system minted its ids. Switching
/// processors writes new rows against the new provider rather than migrating
/// the old ones — the historical record stays intact and readable.
model Subscription {
  id                     String             @id @default(cuid())
  companyId              String             @unique
  /// Which processor issued the identifiers below.
  provider               PaymentProvider    @default(PAYPAL)
  providerCustomerId     String
  providerSubscriptionId String?
  providerPriceId        String?
  status                 SubscriptionStatus @default(NONE)
  plan                   SubscriptionPlan?
  /// Renewal cadence. Null until a subscription actually exists.
  billingInterval        BillingInterval?
  currentPeriodEnd       DateTime?
  cancelAtPeriodEnd      Boolean            @default(false)
  canceledAt             DateTime?
  trialEndsAt            DateTime?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  company                Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invoices               Invoice[]

  /// Scoped to the provider rather than global: two processors may legitimately
  /// mint the same-looking id, and a tenant that moves between them must not
  /// collide with its own former record.
  @@unique([provider, providerCustomerId])
  @@unique([provider, providerSubscriptionId])
  @@index([status])
  @@map("subscriptions")
}

/// A billing document synchronized from the provider, so a tenant can read its
/// payment history without an outbound call on every page view.
///
/// Held deliberately thin: enough to render a history table and link out to the
/// provider's own document. It is a cache, never an accounting record — the
/// provider remains the authority on what was charged.
model Invoice {
  id                    String          @id @default(cuid())
  companyId             String
  subscriptionId        String?
  provider              PaymentProvider
  providerInvoiceId     String
  /// The provider's human-facing reference, shown to the tenant.
  number                String?
  status                InvoiceStatus
  /// ISO 4217, uppercase.
  currency              String
  /// Minor units (cents). Integers only — never store money as a float.
  amountDue             Int
  amountPaid            Int
  issuedAt              DateTime?
  paidAt                DateTime?
  /// Hosted invoice or receipt at the provider, when one exists.
  invoiceUrl            String?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  company               Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  subscription          Subscription?   @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  /// The idempotency key for invoice synchronization: a redelivered webhook
  /// updates the existing row instead of inserting a duplicate.
  @@unique([provider, providerInvoiceId])
  @@index([companyId, issuedAt])
  @@map("invoices")
}

/// The webhook ledger — one row per event the provider has ever sent us.
///
/// This table is what makes webhook processing idempotent. Providers guarantee
/// *at-least-once* delivery: the same event arrives again after a timeout, a
/// 5xx, or a network blip, and events routinely arrive out of order. Inserting
/// the provider's event id under a unique constraint *before* doing any work
/// turns "have I already handled this?" into a database-enforced question
/// rather than an application-level guess.
///
/// What the provisioner created at the payment provider, so the application can
/// find it again.
///
/// The provider is still the source of truth — this table records *which* of its
/// objects are ours. Without it the identifiers would have to be pasted into
/// environment variables by hand, which is the manual step this exists to
/// remove: `npm run billing:paypal:setup` writes these rows, and the API reads
/// them.
///
/// Scoped by `environment` as well as `provider`, because a sandbox plan id and
/// a live one are different objects that must never be confused. Charging a live
/// customer against a sandbox plan fails; charging a sandbox test against a live
/// plan takes real money.
model BillingCatalog {
  id          String          @id @default(cuid())
  provider    PaymentProvider
  /// `sandbox` or `live`. Not an enum: it is the provider's own word for its
  /// estate, and providers do not agree on the vocabulary.
  environment String
  /// The logical name this deployment knows the object by — `product`,
  /// `plan:STARTER:MONTH`, `webhook`. Stable across re-provisioning.
  key         String
  /// The identifier the provider issued: `P-…` for a plan, a webhook id, etc.
  externalId  String
  /// A hash of what we asked the provider to create.
  ///
  /// Lets the provisioner notice that the desired catalogue has changed — a new
  /// price, a renamed plan — and say so, rather than silently continuing to bill
  /// the old object because a row already existed.
  fingerprint String
  /// Anything worth reading back without another API call (amount, currency,
  /// interval). Never a credential.
  metadata    Json?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([provider, environment, key])
  @@map("billing_catalog")
}

/// It doubles as the audit trail: a failed event keeps its error and attempt
/// count, so a delivery that never succeeded is visible rather than lost.
model WebhookEvent {
  id              String             @id @default(cuid())
  provider        PaymentProvider
  /// The provider's own event id. Unique per provider — this is the dedupe key.
  providerEventId String
  eventType       String
  status          WebhookEventStatus @default(PROCESSING)
  /// Delivery count, incremented every time the provider re-sends this event.
  attempts        Int                @default(1)
  /// Last failure message, kept for triage. Null once processed.
  error           String?
  /// When the provider says the event occurred, not when we received it.
  occurredAt      DateTime?
  processedAt     DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@unique([provider, providerEventId])
  @@index([status, createdAt])
  @@map("webhook_events")
}

model AuditLog {
  id         String   @id @default(cuid())
  companyId  String
  userId     String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user       User?    @relation(fields: [userId], references: [id])

  @@index([companyId])
  @@index([companyId, createdAt])
  @@map("audit_logs")
}

enum UserRole {
  OWNER
  ADMIN
  MEMBER
}

/// Authority over the platform itself, held by rooferslabs staff. Separate from
/// UserRole, which is authority inside one company — every customer is a
/// UserRole.OWNER, so that role can never gate the internal admin portal.
enum PlatformRole {
  NONE
  OWNER
}

/// Mirrors `CompanyStatus` in `packages/shared/src/enums.ts`, which documents
/// the lifecycle. ACTIVE is the only value that grants access.
enum CompanyStatus {
  ONBOARDING
  PENDING_APPROVAL
  ACTIVE
  PAUSED
}

enum OnboardingStep {
  COMPANY
  BUSINESS
  AI
  KNOWLEDGE
  COMPLETE
}

enum CallDirection {
  INBOUND
  OUTBOUND
}

enum CallStatus {
  INCOMING
  RINGING
  IN_PROGRESS
  COMPLETED
  FAILED
  NO_ANSWER
  MISSED
}

enum ConversationStatus {
  ACTIVE
  COMPLETED
  ABANDONED
  FAILED
}

enum ConversationOutcome {
  LEAD_CAPTURED
  APPOINTMENT_REQUESTED
  EMERGENCY
  INFORMATION_PROVIDED
  NO_ACTION
  SPAM
}

enum ConversationIntent {
  NEW_ESTIMATE
  EMERGENCY_REPAIR
  REPAIR
  INSPECTION
  WARRANTY
  FOLLOW_UP
  GENERAL_QUESTION
  BILLING
  OTHER
}

enum UrgencyLevel {
  LOW
  MEDIUM
  HIGH
  EMERGENCY
}

enum LeadQuality {
  UNQUALIFIED
  COLD
  WARM
  HOT
}

enum CustomerStatus {
  NEW
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum PropertyType {
  RESIDENTIAL
  COMMERCIAL
  UNKNOWN
}

enum AppointmentStatus {
  REQUESTED
  CONFIRMED
  RESCHEDULED
  COMPLETED
  CANCELLED
}

enum AppointmentPriority {
  LOW
  NORMAL
  HIGH
  EMERGENCY
}

enum KnowledgeCategory {
  BUSINESS_INFO
  SERVICES
  FAQ
  POLICIES
  WARRANTY
  PRICING
  FINANCING
  EMERGENCY
  SERVICE_AREAS
}

enum KnowledgeStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum NotificationType {
  NEW_CALL
  NEW_LEAD
  APPOINTMENT_REQUEST
  EMERGENCY
  CALL_SUMMARY
  SYSTEM
  ACCOUNT
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
}

enum NotificationStatus {
  UNREAD
  READ
  ARCHIVED
}

enum SubscriptionStatus {
  NONE
  INCOMPLETE
  INCOMPLETE_EXPIRED
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  UNPAID
  PAUSED
}

enum SubscriptionPlan {
  STARTER
  PROFESSIONAL
}

/// The payment processor that issued a record's identifiers. Exactly one is
/// active at a time (the API's PAYMENT_PROVIDER); the others stay readable.
enum PaymentProvider {
  PAYPAL
}

/// Renewal cadence. Only MONTH is sold today; YEAR is modelled up front so
/// launching annual plans is a price-configuration change, not a migration.
enum BillingInterval {
  MONTH
  YEAR
}

enum InvoiceStatus {
  DRAFT
  OPEN
  PAID
  VOID
  UNCOLLECTIBLE
}

/// Where a webhook delivery got to. PROCESSING is written before any work
/// begins, so a crash mid-handler leaves evidence rather than a silent gap.
enum WebhookEventStatus {
  PROCESSING
  PROCESSED
  FAILED
  IGNORED
}

enum PhoneNumberStatus {
  PROVISIONED
  ASSIGNED
  ACTIVE
  RELEASED
}
