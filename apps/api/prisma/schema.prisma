generator client {
  provider        = "prisma-client-js"
  previewFeatures = []
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id                      String             @id @default(cuid())
  name                    String
  slug                    String             @unique
  status                  CompanyStatus      @default(ONBOARDING)
  onboardingStep          OnboardingStep     @default(COMPANY)
  onboardedAt             DateTime?
  email                   String?
  phone                   String?
  website                 String?
  addressLine1            String?
  addressLine2            String?
  city                    String?
  state                   String?
  postalCode              String?
  timezone                String             @default("America/New_York")
  serviceAreas            String[]           @default([])
  roofingServices         String[]           @default([])
  businessHours           Json?
  emergencyServiceEnabled Boolean            @default(true)
  emergencyPhone          String?
  emergencyInstructions   String?
  logoUrl                 String?
  primaryColor            String?            @default("#1E40AF")
  secondaryColor          String?
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt
  phoneCarrier            String?
  receptionistEnabled     Boolean            @default(true)
  aiConfiguration         AiConfiguration?
  appointments            Appointment[]
  auditLogs               AuditLog[]
  calls                   Call[]
  conversations           Conversation[]
  customers               Customer[]
  knowledgeArticle        KnowledgeArticle[]
  notifications           Notification[]
  phoneNumbers            PhoneNumber[]
  pushSubscriptions       PushSubscription[]
  subscription            Subscription?
  users                   User[]
  notes                   CompanyNote[]

  @@index([status])
  @@map("companies")
}

model AiConfiguration {
  id                  String   @id @default(cuid())
  companyId           String   @unique
  voice               String   @default("alloy")
  assistantName       String   @default("the RoofersLabs assistant")
  greeting            String   @default("Thanks for calling. How can I help you with your roofing needs today?")
  persona             String   @default("professional, warm, and efficient")
  customInstructions  String?
  captureLeads        Boolean  @default(true)
  detectEmergencies   Boolean  @default(true)
  requestAppointments Boolean  @default(true)
  transferToHuman     Boolean  @default(false)
  transferPhone       String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  company             Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("ai_configurations")
}

model User {
  id                 String             @id @default(cuid())
  companyId          String?
  clerkUserId        String             @unique
  email              String
  firstName          String?
  lastName           String?
  avatarUrl          String?
  role               UserRole           @default(OWNER)
  /// Access to the internal admin portal. Defaults to NONE so a new account
  /// never gains platform access by being created.
  platformRole       PlatformRole       @default(NONE)
  emailNotifications Boolean            @default(true)
  lastActiveAt       DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  deletedAt          DateTime?
  auditLogs          AuditLog[]
  notifications      Notification[]
  pushSubscriptions  PushSubscription[]
  company            Company?           @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@index([email])
  @@map("users")
}

model PhoneNumber {
  id                   String            @id @default(cuid())
  companyId            String
  phoneNumber          String            @unique
  twilioSid            String?           @unique
  friendlyName         String?
  status               PhoneNumberStatus @default(ASSIGNED)
  forwardingVerifiedAt DateTime?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  calls                Call[]
  company              Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("phone_numbers")
}

model Customer {
  id              String         @id @default(cuid())
  companyId       String
  fullName        String?
  phone           String?
  email           String?
  propertyAddress String?
  propertyType    PropertyType   @default(UNKNOWN)
  status          CustomerStatus @default(NEW)
  /// Starred by the company so their most important accounts stay reachable
  /// from any device. Company-wide, not per-user: a small roofing office
  /// shares one view of who matters.
  isFavorite      Boolean        @default(false)
  notes           String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  deletedAt       DateTime?
  appointments    Appointment[]
  calls           Call[]
  conversations   Conversation[]
  company         Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([companyId, phone])
  @@index([companyId, status])
  @@map("customers")
}

model Call {
  id                String        @id @default(cuid())
  companyId         String
  phoneNumberId     String?
  customerId        String?
  twilioCallSid     String?       @unique
  direction         CallDirection @default(INBOUND)
  fromNumber        String?
  toNumber          String?
  status            CallStatus    @default(INCOMING)
  startedAt         DateTime?
  answeredAt        DateTime?
  endedAt           DateTime?
  durationSeconds   Int?
  recordingUrl      String?
  recordingKey      String?
  // Twilio call recording (started automatically for every answered call).
  recordingSid      String?       @unique
  recordingStatus   String?
  recordingDuration Int?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  forwardedFrom     String?
  company           Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer          Customer?     @relation(fields: [customerId], references: [id])
  phoneNumber       PhoneNumber?  @relation(fields: [phoneNumberId], references: [id])
  conversation      Conversation?

  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, createdAt])
  @@map("calls")
}

model Conversation {
  id               String               @id @default(cuid())
  companyId        String
  callId           String               @unique
  customerId       String?
  status           ConversationStatus   @default(ACTIVE)
  outcome          ConversationOutcome?
  intent           ConversationIntent?
  leadQuality      LeadQuality?
  urgency          UrgencyLevel?
  isEmergency      Boolean              @default(false)
  transcript       Json?
  summary          String?
  keyPoints        String[]             @default([])
  structuredOutput Json?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  appointment      Appointment?
  call             Call                 @relation(fields: [callId], references: [id], onDelete: Cascade)
  company          Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer         Customer?            @relation(fields: [customerId], references: [id])

  @@index([companyId])
  @@index([companyId, outcome])
  @@index([companyId, isEmergency])
  @@index([companyId, createdAt])
  @@map("conversations")
}

model Appointment {
  id                  String              @id @default(cuid())
  companyId           String
  customerId          String?
  conversationId      String?             @unique
  serviceRequested    String?
  propertyAddress     String?
  preferredDate       DateTime?
  preferredTimeWindow String?
  status              AppointmentStatus   @default(REQUESTED)
  priority            AppointmentPriority @default(NORMAL)
  notes               String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  deletedAt           DateTime?
  company             Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  conversation        Conversation?       @relation(fields: [conversationId], references: [id])
  customer            Customer?           @relation(fields: [customerId], references: [id])

  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, createdAt])
  @@map("appointments")
}

model KnowledgeArticle {
  id        String            @id @default(cuid())
  companyId String
  title     String
  content   String
  category  KnowledgeCategory @default(FAQ)
  keywords  String[]          @default([])
  status    KnowledgeStatus   @default(PUBLISHED)
  version   Int               @default(1)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  deletedAt DateTime?
  company   Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  chunks    KnowledgeChunk[]

  @@index([companyId])
  @@index([companyId, category])
  @@index([companyId, status])
  @@map("knowledge_articles")
}

model KnowledgeChunk {
  id        String           @id @default(cuid())
  companyId String
  articleId String
  content   String
  embedding Float[]          @default([])
  tokens    Int              @default(0)
  createdAt DateTime         @default(now())
  article   KnowledgeArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([articleId])
  @@map("knowledge_chunks")
}

model Notification {
  id            String               @id @default(cuid())
  companyId     String
  userId        String?
  type          NotificationType
  priority      NotificationPriority @default(NORMAL)
  channel       NotificationChannel  @default(IN_APP)
  status        NotificationStatus   @default(UNREAD)
  title         String
  message       String
  relatedEntity Json?
  readAt        DateTime?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  deletedAt     DateTime?
  company       Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user          User?                @relation(fields: [userId], references: [id])

  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, userId, status])
  @@index([companyId, createdAt])
  @@map("notifications")
}

model PushSubscription {
  id        String   @id @default(cuid())
  companyId String
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([userId])
  @@map("push_subscriptions")
}

/// Billing state for a tenant, mirrored from Stripe by the webhook handler.
/// Stripe is the source of truth; this table is a local read-model so that
/// request-time authorization never depends on an outbound API call.
/// A private operational note about a company, written by RoofersLabs staff.
/// Never exposed through any customer-facing endpoint — the admin controller is
/// the only route that reads or writes it.
model CompanyNote {
  id        String   @id @default(cuid())
  companyId String
  /// The staff user who wrote it. Kept as a plain id, not a relation, so
  /// deleting a staff account never cascades into the operational record.
  authorId  String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, createdAt])
  @@map("company_notes")
}

model Subscription {
  id                   String             @id @default(cuid())
  companyId            String             @unique
  stripeCustomerId     String             @unique
  stripeSubscriptionId String?            @unique
  stripePriceId        String?
  status               SubscriptionStatus @default(NONE)
  plan                 SubscriptionPlan?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  canceledAt           DateTime?
  trialEndsAt          DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  company              Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("subscriptions")
}

model AuditLog {
  id         String   @id @default(cuid())
  companyId  String
  userId     String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user       User?    @relation(fields: [userId], references: [id])

  @@index([companyId])
  @@index([companyId, createdAt])
  @@map("audit_logs")
}

enum UserRole {
  OWNER
  ADMIN
  MEMBER
}

/// Authority over the platform itself, held by RoofersLabs staff. Separate from
/// UserRole, which is authority inside one company — every customer is a
/// UserRole.OWNER, so that role can never gate the internal admin portal.
enum PlatformRole {
  NONE
  OWNER
}

enum CompanyStatus {
  ONBOARDING
  ACTIVE
  SUSPENDED
}

enum OnboardingStep {
  COMPANY
  BUSINESS
  AI
  KNOWLEDGE
  COMPLETE
}

enum CallDirection {
  INBOUND
  OUTBOUND
}

enum CallStatus {
  INCOMING
  RINGING
  IN_PROGRESS
  COMPLETED
  FAILED
  NO_ANSWER
  MISSED
}

enum ConversationStatus {
  ACTIVE
  COMPLETED
  ABANDONED
  FAILED
}

enum ConversationOutcome {
  LEAD_CAPTURED
  APPOINTMENT_REQUESTED
  EMERGENCY
  INFORMATION_PROVIDED
  NO_ACTION
  SPAM
}

enum ConversationIntent {
  NEW_ESTIMATE
  EMERGENCY_REPAIR
  REPAIR
  INSPECTION
  WARRANTY
  FOLLOW_UP
  GENERAL_QUESTION
  BILLING
  OTHER
}

enum UrgencyLevel {
  LOW
  MEDIUM
  HIGH
  EMERGENCY
}

enum LeadQuality {
  UNQUALIFIED
  COLD
  WARM
  HOT
}

enum CustomerStatus {
  NEW
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum PropertyType {
  RESIDENTIAL
  COMMERCIAL
  UNKNOWN
}

enum AppointmentStatus {
  REQUESTED
  CONFIRMED
  RESCHEDULED
  COMPLETED
  CANCELLED
}

enum AppointmentPriority {
  LOW
  NORMAL
  HIGH
  EMERGENCY
}

enum KnowledgeCategory {
  BUSINESS_INFO
  SERVICES
  FAQ
  POLICIES
  WARRANTY
  PRICING
  FINANCING
  EMERGENCY
  SERVICE_AREAS
}

enum KnowledgeStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum NotificationType {
  NEW_CALL
  NEW_LEAD
  APPOINTMENT_REQUEST
  EMERGENCY
  CALL_SUMMARY
  SYSTEM
  ACCOUNT
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
}

enum NotificationStatus {
  UNREAD
  READ
  ARCHIVED
}

enum SubscriptionStatus {
  NONE
  INCOMPLETE
  INCOMPLETE_EXPIRED
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  UNPAID
  PAUSED
}

enum SubscriptionPlan {
  STARTER
  PROFESSIONAL
}

enum PhoneNumberStatus {
  PROVISIONED
  ASSIGNED
  ACTIVE
  RELEASED
}
