# =============================================================================
# RoofersLabs development — copy to terraform.tfvars and fill in.
# NEVER commit terraform.tfvars (it is gitignored).
# =============================================================================
# Every credential here belongs to a DEVELOPMENT or SANDBOX account. Terraform
# refuses the plan on a production key, and the API refuses to boot on one.

aws_region = "us-east-1"

# ---- Access ------------------------------------------------------------------
# The only thing standing between the development database and the internet.
# Find your address:  curl -s https://checkip.amazonaws.com
#
# Re-apply when your address changes. Single addresses only (/32) — the plan
# rejects anything wider.
developer_cidr_blocks = ["203.0.113.42/32"]

# ---- Clerk (DEVELOPMENT instance) --------------------------------------------
# Clerk → switch the instance selector to Development → API Keys.
# Production currently uses this same instance, which is the bug being fixed:
# after the Clerk cutover, production moves to pk_live_/sk_live_ and these keys
# belong to development alone.
clerk_secret_key      = "sk_test_..."
clerk_publishable_key = "pk_test_..."

# ---- OpenAI -------------------------------------------------------------------
# Use a SEPARATE key from production — ideally its own project with a low
# monthly cap, so a runaway local loop cannot spend the production budget.
openai_api_key = "sk-proj-..."

# ---- Twilio (optional) --------------------------------------------------------
# Leave empty unless a separate development subaccount exists. Empty means
# telephony is disabled locally, which is the safe default: the alternative is
# local tests placing real calls on production credentials.
# twilio_account_sid = "AC..."
# twilio_auth_token  = "..."

# ---- Paddle SANDBOX (optional) ------------------------------------------------
# Empty runs local development with the payment wall down. Supply all three to
# exercise billing against Paddle's sandbox, which settles no money.
# A pdl_live_ key here is rejected at plan time.
# paddle_api_key        = "pdl_sdbx_..."
# paddle_client_token   = "test_..."
# paddle_webhook_secret = "pdl_ntfset_..."

# ---- Optional tuning ----------------------------------------------------------
# db_instance_class        = "db.t4g.micro"
# db_backup_retention_days = 1
# vpc_cidr                 = "10.10.0.0/16"   # must not be production's 10.0.0.0/16
