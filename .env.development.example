# =============================================================================
# RoofersLabs — DEVELOPMENT configuration (backend)
# =============================================================================
# Copy to `.env.development` (or to `.env`, which is loaded as a fallback).
# Every value here must be a development credential. See docs/environments.md.
#
# Two ways to work locally, and this file supports both:
#
#   A. Everything on your machine — Postgres and Redis from
#      docker/docker-compose.yml. The defaults below are already set up for it.
#   B. Against the deployed development environment — leave the API on your
#      machine but point WEB_PUBLIC_URL/CORS at it. The database still is not
#      reachable directly (RDS is private); use infra/scripts/db.sh development.
#
# What this file must NEVER contain is a production credential. The deployed
# environments read nothing from disk at all: ECS injects plain values from the
# task definition and secrets from AWS Secrets Manager, both defined in
# infra/terraform/envs/<environment>. See .env.production.example.
# -----------------------------------------------------------------------------

# ---- Core runtime -----------------------------------------------------------
NODE_ENV=development
# Leave APP_ENV unset on a laptop. Setting it to "development" opts in to the
# same full configuration validation the deployed environment gets, which is
# occasionally useful for reproducing a boot failure.
# APP_ENV=development
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000
WEB_PUBLIC_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# ---- Data stores (docker/docker-compose.yml) --------------------------------
DATABASE_URL=postgresql://rooferslabs:rooferslabs@localhost:5432/rooferslabs?schema=public
REDIS_URL=redis://localhost:6379

# ---- Clerk — DEVELOPMENT instance only (pk_test_… / sk_test_…) --------------
CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx
# CLERK_JWT_KEY=
# CLERK_WEBHOOK_SECRET=

# ---- OpenAI -----------------------------------------------------------------
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_REALTIME_MODEL=gpt-realtime
# Fleet default voice. A company's own choice (Settings → AI) always wins.
OPENAI_REALTIME_VOICE=marin
OPENAI_RESPONSES_MODEL=gpt-4.1
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ---- Twilio — a subaccount, not the production account ----------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MEDIA_STREAM_URL=ws://localhost:4000/v1/telephony/media-stream

# ---- AWS --------------------------------------------------------------------
# Credentials come from the provider chain (aws configure / SSO), never from
# here. Leave the bucket and queue names empty to work without AWS at all.
AWS_REGION=us-east-1
S3_BUCKET_RECORDINGS=
S3_BUCKET_UPLOADS=
SQS_QUEUE_URL=
BACKGROUND_JOBS_INLINE=true

# ---- Observability ----------------------------------------------------------
LOG_LEVEL=debug

# ---- Billing — Paddle SANDBOX ----------------------------------------------
# false opens the payment wall entirely, which is usually what you want unless
# billing is what you are working on.
PAYMENTS_ENABLED=false
PAYMENT_PROVIDER=paddle
PADDLE_ENVIRONMENT=sandbox
BILLING_TRIAL_PERIOD_DAYS=0

# PADDLE_API_KEY=pdl_sdbx_apikey_xxxxxxxx
# PADDLE_CLIENT_TOKEN=test_xxxxxxxx
# PADDLE_WEBHOOK_SECRET=pdl_ntfset_xxxxxxxx
# PADDLE_PRICE_STARTER_MONTHLY=pri_xxxxxxxx
# PADDLE_PRICE_PROFESSIONAL_MONTHLY=pri_xxxxxxxx

# ---- Validation price (optional) -------------------------------------------
# Stands in for PADDLE_PRICE_STARTER_MONTHLY so the Founding Customer checkout
# charges a small proving amount instead of the published price. Intended for a
# LIVE account: a sandbox transaction already proves the code path, but proves
# nothing about live keys, live webhook signatures, tax, or money arriving in
# the bank.
#
# Presence is the switch — set it and the validation price is charged, delete it
# and the Founding Customer price is. Nothing else changes, in configuration or
# in code, and the displayed price is unaffected either way because the product
# never reads an amount from Paddle.
#
# Two things to know before setting it on a live account:
#   * Subscriptions created while it is set KEEP billing that amount on renewal.
#     Removing the variable changes what NEW checkouts charge, not what existing
#     subscriptions bill — moving those is a plan change per subscription.
#   * The API logs an error-level line at boot for as long as it is set.
# PADDLE_PRICE_VALIDATION_MONTHLY=pri_xxxxxxxx
