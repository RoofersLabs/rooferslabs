# =============================================================================
# RoofersLabs — DEVELOPMENT configuration (backend)
# =============================================================================
# Copy to `.env.development` (or to `.env`, which is loaded as a fallback).
# Every value here must be a development credential. See docs/environments.md.
#
# Two ways to work locally, and this file supports both:
#
#   A. Everything on your machine — Postgres and Redis from
#      docker/docker-compose.yml. The defaults below are already set up for it.
#   B. Against the deployed development environment — leave the API on your
#      machine but point WEB_PUBLIC_URL/CORS at it. The database still is not
#      reachable directly (RDS is private); use infra/scripts/db.sh development.
#
# What this file must NEVER contain is a production credential. The deployed
# environments read nothing from disk at all: ECS injects plain values from the
# task definition and secrets from AWS Secrets Manager, both defined in
# infra/terraform/envs/<environment>. See .env.production.example.
# -----------------------------------------------------------------------------

# ---- Core runtime -----------------------------------------------------------
NODE_ENV=development
# Leave APP_ENV unset on a laptop. Setting it to "development" opts in to the
# same full configuration validation the deployed environment gets, which is
# occasionally useful for reproducing a boot failure.
# APP_ENV=development
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000
WEB_PUBLIC_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# ---- Data stores (docker/docker-compose.yml) --------------------------------
# There is NO local database or cache. Every environment's Postgres and Redis
# live in AWS, in private subnets with no public endpoint, so nothing on a
# laptop can reach them. Leave these empty; anything needing a database runs
# inside the VPC (infra/scripts/db.sh, infra/scripts/billing.sh).
#
# A deployed tier that resolves either of these to localhost refuses to boot.
DATABASE_URL=
REDIS_URL=

# ---- Clerk — DEVELOPMENT instance only (pk_test_… / sk_test_…) --------------
CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx
# CLERK_JWT_KEY=
# CLERK_WEBHOOK_SECRET=

# ---- OpenAI -----------------------------------------------------------------
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_REALTIME_MODEL=gpt-realtime
# Fleet default voice. A company's own choice (Settings → AI) always wins.
OPENAI_REALTIME_VOICE=marin
OPENAI_RESPONSES_MODEL=gpt-4.1
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ---- Twilio — a subaccount, not the production account ----------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MEDIA_STREAM_URL=ws://localhost:4000/v1/telephony/media-stream

# ---- AWS --------------------------------------------------------------------
# Credentials come from the provider chain (aws configure / SSO), never from
# here. Leave the bucket and queue names empty to work without AWS at all.
AWS_REGION=us-east-1
S3_BUCKET_RECORDINGS=
S3_BUCKET_UPLOADS=
SQS_QUEUE_URL=
BACKGROUND_JOBS_INLINE=true

# ---- Observability ----------------------------------------------------------
LOG_LEVEL=debug

# ---- Billing — PayPal SANDBOX ----------------------------------------------
# false opens the payment wall entirely, which is usually what you want unless
# billing is what you are working on.
PAYMENTS_ENABLED=false
PAYMENT_PROVIDER=paypal
PAYPAL_ENVIRONMENT=sandbox
BILLING_TRIAL_PERIOD_DAYS=0

# From the PayPal Developer Dashboard → Apps & Credentials (Sandbox tab).
#
# THESE TWO ARE THE ONLY BILLING VALUES YOU EVER SET BY HAND.
#
# The product, the billing plans and the webhook are all created by
#   npm run billing:paypal:setup
# which records their ids in the billing_catalog table. No plan id, product id
# or webhook id is ever an environment variable — PayPal exposes all three over
# its API, so there is nothing to copy out of a dashboard.
#
# Both are server-side only. Neither reaches the browser: PayPal's checkout is a
# redirect to an approval URL the API mints, so the client needs no credential.
# PAYPAL_CLIENT_ID=AeA1QIZ...
# PAYPAL_CLIENT_SECRET=EGnHDxD...

# Optional override, for a webhook you registered by hand. Leave it unset and
# setup will register one against API_PUBLIC_URL and remember its id.
#
# PayPal will not deliver to localhost, so registering a webhook locally needs a
# tunnel: run `ngrok http 4000`, set API_PUBLIC_URL to the tunnel origin, then
# run setup. Without one, setup provisions the catalogue and skips the webhook
# with an explanation.
# PAYPAL_WEBHOOK_ID=8PT597110X687430LKGECATA

# ---- Test pricing (temporary) ----------------------------------------------
# Charge $1.00 instead of the published $49.00, so a LIVE payment pipeline can be
# proven end to end — real credentials, real webhook signatures, real money
# arriving in the bank — without taking a full subscription fee to do it.
#
# The $1.00 plan is a SEPARATE PayPal plan created by `billing:paypal:setup`
# alongside the $49.00 one. The published plan is never modified.
#
# When on:  the checkout is created against the $1.00 plan.
# When off: the $49.00 plan, immediately, with no code change and no redeploy of
#           anything but the variable.
#
# Nothing else changes. The site still advertises $49 everywhere; the customer
# sees $1.00 for the first time on PayPal's own approval page. Activation,
# webhooks, entitlement and the billing page are identical either way.
#
# Two things to know before enabling it against a live account:
#   * Subscriptions created while it is on KEEP billing $1.00 on renewal.
#     Turning it off changes what NEW checkouts charge, not what existing
#     subscriptions bill — moving those is a plan revision per subscription.
#   * The API logs an error-level line at boot for as long as it is on, and
#     /v1/health/billing reports testPricing: true.
PAYPAL_TEST_PRICING=false
