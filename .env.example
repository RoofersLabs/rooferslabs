# =============================================================================
# RoofersLabs — local development
# =============================================================================
# Copy to .env and fill in the four credentials marked REQUIRED. Everything else
# already points at the Docker services and needs no edit.
#
#   cp .env.example .env
#   bun run setup
#
# .env is gitignored. Never commit it, and never put production credentials in
# it — the API warns loudly at boot if you do, and `bun run setup` refuses to
# continue if it finds a live Clerk or Paddle key.
#
# Local development touches NO AWS resources. There is nothing to apply, no
# Terraform to run, and no VPN or bastion involved.

# ---- Environment -------------------------------------------------------------

# The deployment tier. Load-bearing: the API's cross-environment guard compares
# every credential below against it, the private-beta launch gate is disabled
# for anything that is not "production", and the web build namespaces its
# service-worker caches by it. Leave this alone.
APP_ENV=development

# The BUILD mode, which is a different question from the tier. Keep as
# development locally so Nest loads pretty logs and skips production-only checks.
NODE_ENV=development

LOG_LEVEL=debug

API_PORT=4000
API_PUBLIC_URL=http://localhost:4000
WEB_PUBLIC_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# ---- Data stores (Docker — started by `bun run setup`) ------------------------
# Credentials match docker/docker-compose.yml. They are local-only and
# deliberately trivial; nothing here is a secret.

DATABASE_URL=postgresql://rooferslabs:rooferslabs@localhost:5432/rooferslabs?schema=public
REDIS_URL=redis://localhost:6379

# ---- Clerk — REQUIRED --------------------------------------------------------
# Clerk Dashboard → switch the instance selector to DEVELOPMENT → API Keys.
#
# Must be pk_test_/sk_test_. A pk_live_ key here points local development at the
# live user directory, where your test sign-ups become real customer records.
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
# Optional: only needed if you are working on Clerk webhooks locally.
# CLERK_WEBHOOK_SECRET=whsec_...

# ---- OpenAI — REQUIRED for the receptionist ----------------------------------
# Use a key on its own project with a low monthly cap. A runaway local loop on a
# shared key spends the production budget.
#
# Leave empty to run without AI: the receptionist and call analysis are disabled
# and the API boots with a warning rather than failing.
OPENAI_API_KEY=

OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_RESPONSES_MODEL=gpt-4.1
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ---- Twilio — optional -------------------------------------------------------
# Empty disables telephony locally, which is the right default. Fill these in
# ONLY with a development subaccount's credentials — production values here mean
# a local test can place a real call and bill a real account.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MEDIA_STREAM_URL=ws://localhost:4000/v1/telephony/media-stream

# ---- Billing — optional ------------------------------------------------------
# PAYMENTS_ENABLED=false runs the app with the payment wall down: every tenant
# reaches the dashboard without subscribing. That is the fastest way to work on
# anything that is not billing.
#
# To exercise billing, set PAYMENTS_ENABLED=true and supply SANDBOX credentials
# (Paddle → sandbox account → Developer tools → Authentication). A pdl_live_ key
# here can charge real payment methods; setup refuses to start if it sees one.
PAYMENTS_ENABLED=false
PAYMENT_PROVIDER=paddle
PADDLE_ENVIRONMENT=sandbox
PADDLE_API_KEY=
PADDLE_CLIENT_TOKEN=
PADDLE_WEBHOOK_SECRET=
PADDLE_PRICE_STARTER_MONTHLY=
PADDLE_PRICE_PROFESSIONAL_MONTHLY=

# ---- AWS — optional, almost never needed -------------------------------------
# Only call recordings and file uploads touch S3. Everything else works without
# any AWS access at all, and there are deliberately no access keys here: if you
# do need S3 locally, authenticate with `aws sso login` (or `aws configure`) and
# the SDK picks the credentials up from the provider chain.
#
# Static keys in a .env are the thing most likely to end up in a git history or
# a screen share, so this file does not invite them.
AWS_REGION=us-east-1
S3_BUCKET_RECORDINGS=
S3_BUCKET_UPLOADS=
BACKGROUND_JOBS_INLINE=true

# ---- Web Push — optional -----------------------------------------------------
# Generate a pair with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:dev@rooferslabs.com
