# =============================================================================
# RoofersLabs — r1 echo — Environment Configuration
# =============================================================================
# Copy this file to `.env` at the repository root for local development.
# In production, these values are sourced from AWS Secrets Manager (see
# docs/10_AWS_Infrastructure.md). NEVER commit a populated `.env`.
#
# Each section notes: (a) which service the value comes from, (b) why it is
# needed, and (c) where to configure it.
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# Core runtime
# -----------------------------------------------------------------------------
NODE_ENV=development
# Backend API (NestJS) HTTP port
API_PORT=4000
# Public base URL of the backend API (used for webhook callbacks + Swagger)
API_PUBLIC_URL=http://localhost:4000
# Public base URL of the frontend PWA (used for CORS + Clerk redirects)
WEB_PUBLIC_URL=http://localhost:5173
# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:5173

# -----------------------------------------------------------------------------
# PostgreSQL (Amazon RDS in production) — Prisma connection string
#   Service: PostgreSQL 16. Locally provided by docker/docker-compose.yml.
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://rooferslabs:rooferslabs@localhost:5432/rooferslabs?schema=public

# -----------------------------------------------------------------------------
# Redis (Amazon ElastiCache in production) — cache + rate limiting + call state
#   Service: Redis 7. Locally provided by docker/docker-compose.yml.
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# -----------------------------------------------------------------------------
# Clerk — Authentication & identity provider
#   Service: https://clerk.com  →  Dashboard → API Keys
#   Why: verifies user identity (registration, login, sessions). The backend
#        verifies Clerk-issued JWTs; the frontend renders Clerk sign-in UI.
#   Configure backend: CLERK_SECRET_KEY, CLERK_PUBLISHABLE_KEY, CLERK_JWT_KEY
#   Configure frontend: VITE_CLERK_PUBLISHABLE_KEY (see apps/web/.env)
# -----------------------------------------------------------------------------
CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional: PEM public key for offline JWT verification (Clerk → JWT Templates).
# If omitted, the backend verifies tokens against Clerk's JWKS endpoint.
CLERK_JWT_KEY=
# Signing secret for Clerk webhooks (Clerk → Webhooks). Used to sync user data.
CLERK_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# -----------------------------------------------------------------------------
# OpenAI — Realtime API (voice) + Responses API (reasoning / structured output)
#   Service: https://platform.openai.com  →  API keys
#   Why: powers the AI receptionist voice conversation and post-call extraction.
# -----------------------------------------------------------------------------
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_RESPONSES_MODEL=gpt-4.1
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# -----------------------------------------------------------------------------
# Twilio — Telephony (Programmable Voice + Media Streams)
#   Service: https://twilio.com  →  Console → Account Info + Phone Numbers
#   Why: receives inbound calls forwarded from the roofer's business line and
#        streams audio to the AI receptionist.
# -----------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# The public wss:// URL Twilio Media Streams connects to (usually API_PUBLIC_URL
# with a wss scheme). In production this is the Cloudflare-fronted API domain.
TWILIO_MEDIA_STREAM_URL=ws://localhost:4000/v1/telephony/media-stream

# -----------------------------------------------------------------------------
# AWS — S3 (recordings/logos), SQS (background jobs), Secrets Manager, CloudWatch
#   Service: https://console.aws.amazon.com
#   Why: object storage for recordings + queue for post-call background work.
#   Local dev can use these with real AWS creds, or leave blank to disable.
# -----------------------------------------------------------------------------
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_RECORDINGS=rooferslabs-recordings-dev
S3_BUCKET_UPLOADS=rooferslabs-uploads-dev
SQS_QUEUE_URL=
# Set to "true" to process background jobs in-process instead of via SQS
# (recommended for local development without AWS credentials).
BACKGROUND_JOBS_INLINE=true

# -----------------------------------------------------------------------------
# Web Push (PWA notifications)
#   Generate once with: npx web-push generate-vapid-keys
#   Why: delivers lead/emergency alerts to the owner's installed PWA even when
#        the app is closed. Leave blank to disable (in-app notifications and
#        SMS still work).
# -----------------------------------------------------------------------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@rooferslabs.com

# -----------------------------------------------------------------------------
# Observability
# -----------------------------------------------------------------------------
LOG_LEVEL=debug
