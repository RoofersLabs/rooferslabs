{
  "name": "rooferslabs",
  "version": "0.1.0",
  "private": true,
  "description": "RoofersLabs \u2014 AI-Powered Front Office Platform for Roofing Companies (r1 echo MVP)",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20 <27"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "prepare": "command -v husky >/dev/null 2>&1 && husky || true",
    "build": "npm run build --workspace @rooferslabs/shared && npm run build --workspace @rooferslabs/api && npm run build --workspace @rooferslabs/web",
    "build:shared": "npm run build --workspace @rooferslabs/shared",
    "dev:api": "npm run dev --workspace @rooferslabs/api",
    "dev:web": "npm run dev --workspace @rooferslabs/web",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "format": "prettier --write \"{apps,packages,infra}/**/*.{ts,tsx,js,jsx,json,md}\" \"*.{json,md}\" \".*.json\"",
    "format:check": "prettier --check \"{apps,packages,infra}/**/*.{ts,tsx,js,jsx,json,md}\" \"*.{json,md}\" \".*.json\"",
    "prisma:generate": "npm run prisma:generate --workspace @rooferslabs/api",
    "prisma:migrate": "npm run prisma:migrate --workspace @rooferslabs/api",
    "prisma:seed": "npm run prisma:seed --workspace @rooferslabs/api"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "husky": "^9.1.7",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3"
  }
}
