# Dependencies
node_modules/
# node_modules renamed aside for a clean reinstall (iCloud-synced Desktop makes
# `rm -rf node_modules` unsafe, so we move it here instead)
.nm-trash/

# Build output
.next/
dist/
build/
out/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Environment variables. The .example templates are tracked; nothing that could
# hold a real value ever is — including the per-tier .env.development /
# .env.production files, which are generated from those templates by hand.
.env
.env.*
!.env.example
!.env.*.example

# OS files
.DS_Store
Thumbs.db

# IDE
# `.vscode/settings.json` is tracked deliberately: it pins the Prisma extension
# to its Prisma 6 language server. Without it the editor validates this schema
# against Prisma 7 grammar and reports errors the CLI does not — a project fact,
# not a personal preference, so everyone needs it.
.idea/

# Coverage
coverage/

# Cache
.cache/
.turbo/

# TypeScript
*.tsbuildinfo

# Temporary files
tmp/
temp/

# Bun
bun.lockb

# Local Claude settings (optional)
.claude/local/
.claude/skills/
.gstack/
# Agent skill packs installed per-developer via `npx skills add`. Vendoring
# third-party skill content into the product repo is a separate decision.
.agents/
skills-lock.json

# Terraform (the .terraform.lock.hcl provider lock file IS committed)
**/.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
crash.log

# design-sync tooling (external claude.ai/design sync; not part of the app build)
.design-sync/
.ds-sync/
ds-bundle/
apps/web/.ds-sync-styles.css

# Generated deploy state (ECR image digests emitted by the deploy scripts)
infra/terraform/envs/*/images.json
